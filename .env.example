EVENTS_TOKEN=change-me-long-random-string   # master secret; each machine gets HMAC(EVENTS_TOKEN, id) via install-hooks.sh
MCP_TOKEN=change-me-another-random-string   # required for every /mcp client that is not the Cloudflare tunnel
CF_ACCESS_TEAM_DOMAIN=                      # e.g. myteam.cloudflareaccess.com (tunnel / Claude app access)
CF_ACCESS_AUD=                              # the Access application's Audience (AUD) tag
PORT=8787
HOST=127.0.0.1                              # 0.0.0.0 or the Tailscale IP so other machines can POST /events
DB_PATH=/var/lib/session-orchestrator/orchestrator.db
CONFIG_DIR=/opt/session-orchestrator/config
BRAIN_DIR=~/brain
REMOTE_BRAIN_DIR=~/brain                    # brain location on the other machines
BRAIN_PUSH=0                                # 1 = git push after every brain commit
LLM_TIMEOUT_S=300
