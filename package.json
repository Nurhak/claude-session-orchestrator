{
  "name": "claude-session-orchestrator",
  "version": "0.1.0",
  "description": "MCP server to manage all your Claude Code sessions across machines from one place (Claude app, voice, or another session): tmux + SSH, permission approvals, shared memory, local LLM routing.",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "tmux",
    "remote-control",
    "orchestrator",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nurhak/claude-session-orchestrator.git"
  },
  "homepage": "https://github.com/Nurhak/claude-session-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/Nurhak/claude-session-orchestrator/issues"
  }
}
